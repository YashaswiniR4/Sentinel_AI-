# SentinelAI Backend Environment Configuration Example
# Copy to .env and configure your PostgreSQL database credentials

SECRET_KEY=sentinelai_super_secret_jwt_key_2026
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sentinelai

# SMTP Email Delivery Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user_placeholder
SMTP_PASSWORD=smtp_password_placeholder
SMTP_FROM_EMAIL=noreply@sentinelai.io
SMTP_TLS=True
SMTP_SSL=False

